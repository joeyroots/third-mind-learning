<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <script src="/assets/js/gtm.js?v={{ site.buildStamp }}"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {%- if unlisted %}<meta name="robots" content="noindex, nofollow">{% endif %}
    <link rel="preload" href="/assets/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/source-serif-4-latin-600.woff2" as="font" type="font/woff2" crossorigin>
    {%- if preloadImage %}
    <link rel="preload" as="image" type="image/avif" href="{{ preloadImage.href }}" imagesrcset="{{ preloadImage.srcset }}" imagesizes="{{ preloadImage.sizes }}" fetchpriority="high">
    {%- endif %}
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {%- set shareImage = ogImage or site.ogImage %}
    {%- if shareImage %}
    <meta property="og:image" content="{{ site.url }}{{ shareImage }}">
    <meta name="twitter:card" content="summary_large_image">
    {%- else %}
    <meta name="twitter:card" content="summary">
    {%- endif %}
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">

    <link rel="stylesheet" href="/assets/css/site.css?v={{ site.buildStamp }}">
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TZMCLS3X" height="0" width="0" title="Google Tag Manager" hidden></iframe></noscript>
    {%- include "components/announcement-bar.njk" %}
    {% include "components/site-header.njk" %}
    <main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
      {{ content | safe }}
    </main>
    {% include "components/site-footer.njk" %}
    <script src="/assets/js/menu.js?v={{ site.buildStamp }}" defer></script>
  </body>
</html>
