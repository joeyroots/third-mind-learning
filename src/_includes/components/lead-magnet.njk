{#- Inline guide offer (never a popup): guide cover + one-field form.
    Placeholder until the GHL form exists (D8); the field is disabled so
    nothing can be submitted from the prototype. -#}
<div class="section">
  <div class="container lead-magnet">
    <div class="lead-magnet__cover" aria-hidden="true">
      <svg class="lead-magnet__mark" viewBox="0 0 64 64" focusable="false"><path d="M10 32 C16 16, 22 16, 26.5 32 S37 48, 41.5 32 S48 16, 54 32"/></svg>
      <span class="lead-magnet__cover-title">{{ leadMagnet.title }}</span>
      <span class="lead-magnet__cover-brand">{{ site.title }}</span>
    </div>
    <div class="lead-magnet__body">
      <!-- CONTENT: lead-magnet copy and form are placeholders until the GHL form is ready (D8). -->
      {% include "components/placeholder-tag.njk" %}
      <h2>{{ leadMagnet.title }}</h2>
      <p>{{ leadMagnet.text | safe }}</p>
      <div class="lead-magnet__form">
        <label for="guide-email">Email address</label>
        <div class="lead-magnet__row">
          <input id="guide-email" type="email" autocomplete="email" disabled>
          <button class="button" type="button" disabled>Send me the guide</button>
        </div>
      </div>
    </div>
  </div>
</div>
