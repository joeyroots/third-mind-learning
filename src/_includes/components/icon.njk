{#- Small line icons (24px grid, stroke = currentColor). Decorative only:
    every use sits beside text that carries the meaning. -#}
{%- macro icon(name) -%}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if name == "people" %}<circle cx="9" cy="8" r="3.25"/><path d="M3 19.5c.6-3.4 3-5.5 6-5.5s5.4 2.1 6 5.5"/><path d="M15.5 4.9a3.25 3.25 0 0 1 0 6.2"/><path d="M17.5 14.4c1.8.7 3 2.5 3.5 5.1"/>
{%- elif name == "heart" %}<path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.4a4.3 4.3 0 0 1 7.5 2.4C19.5 15.4 12 20 12 20z"/><path d="M7.5 12.5h2.2l1.2-2 2.2 4 1.2-2h2.2"/>
{%- elif name == "pencil" %}<path d="M4 20l1-4.5L15.8 4.7a2 2 0 0 1 2.8 0l.7.7a2 2 0 0 1 0 2.8L8.5 19 4 20z"/><path d="M14 6.5l3.5 3.5"/>
{%- elif name == "check" %}<path d="M5 12.5l4.5 4.5L19 7.5"/>
{%- elif name == "dot" %}<circle cx="12" cy="12" r="3"/>
{%- elif name == "wave" %}<path d="M3 12c2.2-5 4.3-5 6 0s3.8 5 6 0 3.8-5 6 0"/>
{%- elif name == "flag" %}<path d="M5 21V4"/><path d="M5 4h11l-2 4 2 4H5"/>
{%- endif %}
</svg>
{%- endmacro %}
